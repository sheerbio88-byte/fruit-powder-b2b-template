---
import { getLocaleFromPath, switchLocalePath, LOCALES, LOCALE_META } from '~/i18n/locales';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<details class:list={['relative', className]} data-locale-switch>
  <summary
    class="cursor-pointer list-none rounded border border-stone-200 px-2 py-1 text-[11px] font-semibold tracking-wide text-muted [&::-webkit-details-marker]:hidden"
  >
    {LOCALE_META[locale].name}
  </summary>
  <ul
    class="absolute end-0 z-[80] mt-1 max-h-[min(70vh,22rem)] min-w-[9rem] overflow-y-auto overscroll-contain rounded-lg border border-stone-200 bg-elevated py-1 text-xs shadow-lg"
  >
    {
      LOCALES.map((loc) => (
        <li>
          <a
            href={switchLocalePath(Astro.url.pathname + Astro.url.hash, loc)}
            lang={LOCALE_META[loc].htmlLang}
            class:list={[
              'block px-3 py-1.5 hover:bg-soft',
              loc === locale ? 'font-bold text-primary' : 'text-muted',
            ]}
            aria-current={loc === locale ? 'true' : undefined}
          >
            {LOCALE_META[loc].name}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script is:inline>
  (function () {
    if (window.__ssfLocaleOutside) return;
    window.__ssfLocaleOutside = true;
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target) return;
      document.querySelectorAll('details[data-locale-switch][open]').forEach(function (menu) {
        if (!menu.contains(target)) menu.open = false;
      });
    });
  })();
</script>
