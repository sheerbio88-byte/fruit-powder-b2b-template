---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Fraunces Variable';
    --aw-font-heading: 'Fraunces Variable';

    /* Premium Wellness — warm cream + sage + terracotta */
    --aw-color-primary: #3f6f5b;
    --aw-color-secondary: #2f5646;
    --aw-color-accent: #c4785a;

    --aw-color-text-heading: #1c1917;
    --aw-color-text-default: #1c1917;
    --aw-color-text-muted: rgb(68 64 60 / 78%);
    --aw-color-text-page: #1c1917;

    --aw-color-bg-page: #faf7f2;
    --aw-color-bg-elevated: #ffffff;
    --aw-color-bg-soft: #f0ebe3;
    --aw-color-bg-page-dark: #1c1917;

    --aw-color-border: rgb(28 25 23 / 10%);

    ::selection {
      background-color: rgb(63 111 91 / 22%);
      color: #1c1917;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Fraunces Variable';
    --aw-font-heading: 'Fraunces Variable';

    --aw-color-primary: #7d9f8c;
    --aw-color-secondary: #a3bdb0;
    --aw-color-accent: #e0a48a;

    --aw-color-text-heading: #faf7f2;
    --aw-color-text-default: #f5f0e8;
    --aw-color-text-muted: rgb(245 240 232 / 68%);
    --aw-color-text-page: #f5f0e8;

    --aw-color-bg-page: #1c1917;
    --aw-color-bg-elevated: #292524;
    --aw-color-bg-soft: #292524;
    --aw-color-bg-page-dark: #0c0a09;

    --aw-color-border: rgb(245 240 232 / 12%);

    ::selection {
      background-color: rgb(125 159 140 / 35%);
      color: #faf7f2;
    }
  }
</style>
