---
import Layout from '~/layouts/Layout.astro';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';
import type { MetaData } from '~/types';

interface Props {
  metadata?: MetaData;
  /** Extra footer space so the mobile quote bar does not cover the last links. */
  reserveMobileBar?: boolean;
  /** Header quote link. Omit it on the index, which has no form. */
  quoteHref?: string;
}

const { metadata, reserveMobileBar = false, quoteHref = '#inquiry-form' } = Astro.props;
---

<Layout metadata={metadata}>
  <header class="sticky top-0 z-40 border-b border-stone-200/70 bg-page/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      {quoteHref ? <a href={quoteHref} class="btn-primary text-sm py-2 px-4">Get quote</a> : null}
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class:list={['border-t border-stone-200/80 bg-soft/40', reserveMobileBar && 'max-md:pb-24']}>
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between md:px-6"
    >
      <p>© {new Date().getFullYear()} Sheer Superfood · Xi'an, China</p>
    </div>
  </footer>
</Layout>
