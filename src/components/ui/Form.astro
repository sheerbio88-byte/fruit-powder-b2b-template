---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import { getTurnstileSiteKey } from '~/config/turnstile';
import { SOURCE_SITE } from '~/config/supabase';

export interface FormProps extends Props {
  /** Unique prefix so multiple forms on one page don't clash on field ids */
  formId?: string;
  class?: string;
  /** Tighter spacing / smaller controls (modals) */
  compact?: boolean;
  /** Wait for ssf:render-turnstile before loading the widget (closed dialogs). */
  deferTurnstile?: boolean;
  /**
   * Pin submit button at the bottom: fields scroll, actions stay fixed.
   * Parent should be a flex column with a max-height (e.g. modal body).
   */
  stickyActions?: boolean;
}

const {
  inputs = [],
  textarea,
  disclaimer,
  button = 'Contact us',
  description = '',
  formId = 'inquiry',
  class: className = '',
  compact = false,
  stickyActions = false,
  deferTurnstile = false,
} = Astro.props as FormProps;

const turnstileSiteKey = getTurnstileSiteKey();
const sourceSite = SOURCE_SITE;

const fieldGap = compact ? 'space-y-3' : 'space-y-6';
const labelClass = compact ? 'block text-xs font-medium mb-1' : 'block text-sm font-medium mb-1.5';
const fieldClass = compact
  ? 'py-2 px-3 block w-full text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary-500'
  : 'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary-500';
const errorClass = compact
  ? 'error-message text-red-600 text-xs mt-0.5 hidden'
  : 'error-message text-red-600 text-sm mt-1 hidden';
const disclaimerLabelClass = compact
  ? 'cursor-pointer select-none text-xs leading-snug text-gray-600 dark:text-gray-400'
  : 'cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400';
---

<form
  id={`${formId}-form`}
  method="POST"
  class:list={[
    'relative min-w-0 max-w-full',
    stickyActions ? 'flex min-h-0 flex-1 flex-col' : fieldGap,
    className,
  ]}
  novalidate
  data-inquiry-form
  data-source-site={sourceSite}
  data-turnstile-sitekey={turnstileSiteKey ?? ''}
  data-turnstile-defer={deferTurnstile ? '1' : undefined}
>
  <div
    class:list={[
      fieldGap,
      stickyActions &&
        'min-h-0 min-w-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain',
      stickyActions && (compact ? 'px-4 py-3 sm:px-5' : 'px-5 py-4 sm:px-6 sm:py-5'),
    ]}
  >
  {
    inputs &&
      inputs.map((input) => {
        const {
          type = 'text',
          name,
          label = '',
          autocomplete = 'on',
          placeholder = '',
          options = [],
          required,
        } = input;
        if (!name) return null;

        const fieldId = `${formId}-${name}`;

        // Text fields default required (legacy); select only when required: true; required: false opts out
        const isCoreIdentity =
          name === 'name' ||
          name === 'email' ||
          name === 'your-name' ||
          name === 'your-email' ||
          type === 'email';
        const isRequired =
          isCoreIdentity || (type === 'select' ? required === true : required !== false);

        if (type === 'select') {
          return (
            <div>
              {label && (
                <label for={fieldId} class={labelClass}>
                  {label}
                  {isRequired && (
                    <span class="text-red-500" aria-hidden="true">
                      {' '}
                      *
                    </span>
                  )}
                </label>
              )}
              <select id={fieldId} name={name} required={isRequired} class={fieldClass}>
                <option value="">{placeholder || 'Please select…'}</option>
                {options.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
              <p class={errorClass} />
            </div>
          );
        }

        return (
          <div>
            {label && (
              <label for={fieldId} class={labelClass}>
                {label}
                {isRequired && (
                  <span class="text-red-500" aria-hidden="true">
                    {' '}
                    *
                  </span>
                )}
              </label>
            )}
            <input
              type={type}
              name={name}
              id={fieldId}
              autocomplete={autocomplete}
              placeholder={placeholder}
              required={isRequired}
              class={fieldClass}
            />
            <p class={errorClass} />
          </div>
        );
      })
  }

  {
    textarea && (
      <div>
        <label for={`${formId}-message`} class={labelClass}>
          {textarea.label}
          {(textarea.required !== false) && (
            <span class="text-red-500" aria-hidden="true">
              {' '}
              *
            </span>
          )}
        </label>
        <textarea
          id={`${formId}-message`}
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : compact ? 3 : 5}
          placeholder={textarea.placeholder}
          required={textarea.required !== false}
          class={fieldClass}
        />
        <p class={errorClass} />
      </div>
    )
  }

  {
    disclaimer && (
      <div class:list={['flex items-start', compact ? 'gap-2' : 'gap-3']}>
        <input
          id={`${formId}-disclaimer`}
          name="disclaimer"
          type="checkbox"
          disabled
          checked
          class:list={['accent-primary-600 shrink-0', compact ? 'mt-0.5 h-3.5 w-3.5' : 'mt-1 h-4 w-4']}
        />
        <label for={`${formId}-disclaimer`} class={disclaimerLabelClass}>
          {disclaimer.label}
        </label>
      </div>
    )
  }

  {/* Honeypot — clip (not off-screen) so it never expands document width on mobile */}
  <div
    class="pointer-events-none absolute h-px w-px overflow-hidden whitespace-nowrap opacity-0"
    style="clip: rect(0, 0, 0, 0); clip-path: inset(50%);"
    aria-hidden="true"
  >
    <label for={`${formId}-website`}>Website</label>
    <input
      type="text"
      id={`${formId}-website`}
      name="website"
      tabindex="-1"
      autocomplete="off"
      value=""
    />
  </div>

  {/* Cloudflare Turnstile */}
  <div class:list={['min-w-0 max-w-full', compact ? '' : 'mb-2']} data-turnstile-wrap>
    <p class={labelClass}>
      Human verification <span class="text-red-500" aria-hidden="true">*</span>
    </p>
    {
      turnstileSiteKey ? (
        <div class="cf-turnstile" data-turnstile-widget></div>
      ) : (
        <p class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs break-words text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100">
          Cloudflare Turnstile is not configured. Set the site key in{' '}
          <code class="break-all text-xs">src/config/turnstile.ts</code> or{' '}
          <code class="break-all text-xs">PUBLIC_TURNSTILE_SITE_KEY</code>.
        </p>
      )
    }
    <p class={errorClass} data-turnstile-error />
  </div>
  </div>

  <div
    class:list={[
      stickyActions
        ? [
            'shrink-0 border-t border-gray-100 bg-white dark:border-slate-800 dark:bg-slate-900',
            compact ? 'px-4 py-3 sm:px-5' : 'px-5 py-4 sm:px-6',
          ]
        : null,
    ]}
  >
  {
    button && (
      <div class:list={[!stickyActions && (compact ? 'pt-1' : 'pt-4')]}>
        <Button variant="primary" type="submit" class={`w-full${compact ? ' py-2.5 text-sm' : ''}`}>
          {button}
        </Button>
      </div>
    )
  }

  <div
    class:list={['form-message hidden text-center', compact ? 'mt-2 text-xs' : 'mt-4 text-sm']}
    role="status"
    aria-live="polite"
  >
    {description && <p class="sr-only">{description}</p>}
  </div>
  </div>
</form>

<script>
  import { getSupabaseClient } from '~/lib/supabase';
  import type { ContactInquiryInsert } from '~/types/contact-inquiry';
  import { resolveClientGeo } from '~/utils/client-geo';
  import { resolveLeadSource } from '~/utils/lead-source';
  import { FORM_STATUS } from '~/i18n/forms';
  import { isLocale, type Locale } from '~/i18n/locales';

  function pageLocale(): Locale {
    const first = window.location.pathname.split('/').filter(Boolean)[0];
    return isLocale(first) ? first : 'en';
  }

  function thanksPath(): string {
    const locale = pageLocale();
    return locale === 'en' ? '/contact/thanks/' : `/${locale}/contact/thanks/`;
  }

  /** Internal fields that must never land in contact_inquiries.extra */
  const ANTI_BOT_KEYS = new Set([
    'website',
    'g-recaptcha-response',
    'cf-turnstile-response',
    'disclaimer',
  ]);

  const TURNSTILE_SCRIPT_ID = 'cf-turnstile-api';
  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';

  type TurnstileApi = {
    render: (
      container: string | HTMLElement,
      parameters: {
        sitekey: string;
        theme?: 'light' | 'dark' | 'auto';
        size?: 'normal' | 'compact' | 'flexible';
        callback?: (token: string) => void;
        'expired-callback'?: () => void;
        'error-callback'?: () => void;
        'timeout-callback'?: () => void;
      }
    ) => string;
    reset: (widgetId?: string) => void;
    remove: (widgetId: string) => void;
    getResponse: (widgetId?: string) => string;
  };

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  function isValidEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  /** Normalize email for storage + duplicate checks (trim + lowercase) */
  function normalizeEmail(email: string) {
    return email.trim().toLowerCase();
  }

  function getField(formData: FormData, ...keys: string[]) {
    for (const key of keys) {
      const value = formData.get(key);
      if (typeof value === 'string' && value.trim()) return value.trim();
    }
    return '';
  }

  function preferredTurnstileTheme(): 'light' | 'dark' | 'auto' {
    if (typeof document === 'undefined') return 'auto';
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  let turnstileScriptPromise: Promise<TurnstileApi> | null = null;

  function loadTurnstileScript(): Promise<TurnstileApi> {
    if (typeof window === 'undefined') {
      return Promise.reject(new Error('No window'));
    }
    if (window.turnstile?.render) {
      return Promise.resolve(window.turnstile);
    }
    if (turnstileScriptPromise) return turnstileScriptPromise;

    turnstileScriptPromise = new Promise((resolve, reject) => {
      const existing = document.getElementById(TURNSTILE_SCRIPT_ID) as HTMLScriptElement | null;
      const waitReady = () => {
        if (window.turnstile?.render) {
          resolve(window.turnstile);
        } else {
          setTimeout(waitReady, 50);
        }
      };

      if (existing) {
        waitReady();
        return;
      }

      const script = document.createElement('script');
      script.id = TURNSTILE_SCRIPT_ID;
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.defer = true;
      script.onload = waitReady;
      script.onerror = () => {
        turnstileScriptPromise = null;
        reject(new Error('Failed to load Cloudflare Turnstile'));
      };
      document.head.appendChild(script);
    });

    return turnstileScriptPromise;
  }

  function buildPayload(
    formData: FormData,
    geo: Awaited<ReturnType<typeof resolveClientGeo>>
  ): ContactInquiryInsert {
    // Same field set and mapping as sheerdds inquiry-client buildRow.
    const company = getField(formData, 'company');
    const buyerType = getField(formData, 'buyer_type');
    const channel = getField(formData, 'channel');
    const product = getField(formData, 'product');
    const volume = getField(formData, 'volume');
    const phone = getField(formData, 'phone', 'your-phone', 'whatsapp');
    const rawMessage = getField(formData, 'message');
    const detected = resolveLeadSource();
    const lines = [
      company && `Company: ${company}`,
      buyerType && `Buyer type: ${buyerType}`,
      channel && `Looking for: ${channel}`,
      product && `Product: ${product}`,
      volume && `Volume: ${volume}`,
      phone && `Phone/WhatsApp: ${phone}`,
      rawMessage && `Notes: ${rawMessage}`,
    ].filter(Boolean);
    return {
      name: getField(formData, 'name'),
      email: normalizeEmail(getField(formData, 'email')),
      message: lines.join('\n'),
      company: company || null,
      channel: channel || null,
      product_interest: product || null,
      source_page: typeof window !== 'undefined' ? window.location.href : null,
      user_agent: typeof navigator !== 'undefined' ? navigator.userAgent : null,
      ip_address: geo.ip_address,
      country: geo.country,
      country_code: geo.country_code,
      region: geo.region,
      lead_source: detected.lead_source,
      status: 'new',
      notes: '',
      extra: {
        buyer_type: buyerType || null,
        volume: volume || null,
        phone: phone || null,
        attribution: detected.attribution,
        landing_page: detected.attribution.landing_page || null,
      },
    };
  }

  function bindInquiryForm(form: HTMLFormElement) {
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const statusEl = form.querySelector<HTMLElement>('.form-message');
    if (!statusEl) return;
    const messageDiv: HTMLElement = statusEl;

    const siteKey = (form.dataset.turnstileSitekey || '').trim();
    const turnstileContainer = form.querySelector<HTMLElement>('[data-turnstile-widget]');
    const turnstileError = form.querySelector<HTMLElement>('[data-turnstile-error]');
    const honeypotInput = form.querySelector<HTMLInputElement>('input[name="website"]');
    const copy = FORM_STATUS[pageLocale()];

    let widgetId: string | null = null;

    function showTurnstileError(text: string) {
      if (turnstileError) {
        turnstileError.textContent = text;
        turnstileError.classList.remove('hidden');
      }
    }

    function clearTurnstileError() {
      if (turnstileError) {
        turnstileError.classList.add('hidden');
        turnstileError.textContent = '';
      }
    }

    function resetTurnstile() {
      if (widgetId === null || !window.turnstile) return;
      try {
        window.turnstile.reset(widgetId);
      } catch {
        /* widget may already be gone after view swap */
      }
    }

    async function ensureTurnstileRendered() {
      if (!siteKey || !turnstileContainer) return;
      if (turnstileContainer.dataset.widgetId) {
        widgetId = turnstileContainer.dataset.widgetId;
        return;
      }
      if (turnstileContainer.childElementCount > 0) return;

      try {
        const turnstile = await loadTurnstileScript();
        widgetId = turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          theme: preferredTurnstileTheme(),
          size: 'flexible',
          callback: () => clearTurnstileError(),
          'expired-callback': () => {
            showTurnstileError(copy.turnstileExpired);
          },
          'error-callback': () => {
            showTurnstileError(copy.turnstileError);
          },
          'timeout-callback': () => {
            showTurnstileError(copy.turnstileTimeout);
          },
        });
        turnstileContainer.dataset.widgetId = widgetId;
      } catch (err) {
        console.error('[inquiry form] Turnstile render failed', err);
        showTurnstileError(copy.turnstileLoad);
      }
    }

    function getTurnstileToken(): string {
      if (!siteKey) return '';
      if (widgetId !== null && window.turnstile) {
        return window.turnstile.getResponse(widgetId) || '';
      }
      const responseField = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
      return responseField?.value?.trim() || '';
    }

    function validateHumanChecks(): boolean {
      if (honeypotInput?.value.trim()) {
        return false;
      }

      if (!siteKey) {
        showTurnstileError(copy.turnstileMissing);
        return false;
      }

      const token = getTurnstileToken();
      if (!token) {
        showTurnstileError(copy.turnstileIncomplete);
        return false;
      }

      return true;
    }

    form.addEventListener('ssf:render-turnstile', () => {
      void ensureTurnstileRendered();
    });
    if (form.dataset.turnstileDefer !== '1') void ensureTurnstileRendered();

    function setFieldError(
      field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
      message: string
    ) {
      const errorEl = field.parentElement?.querySelector('.error-message');
      field.classList.add('border-red-500', 'focus:ring-red-500');
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
    }

    function validateForm() {
      let isValid = true;
      const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        'input:not([type="checkbox"]):not([type="hidden"]):not([disabled]):not([name="website"]):not([name="cf-turnstile-response"]), textarea:not([name="g-recaptcha-response"]):not([name="cf-turnstile-response"]), select'
      );

      fields.forEach((field) => {
        const errorEl = field.parentElement?.querySelector('.error-message');
        const value = field.value.trim();
        const mustFill = field.required;

        field.classList.remove('border-red-500', 'focus:ring-red-500');
        if (errorEl) errorEl.classList.add('hidden');

        const isEmailField =
          ('type' in field && field.type === 'email') ||
          field.name === 'email' ||
          field.name === 'your-email';
        const isMessageField = field.name === 'message' || field.name === 'your-message';

        if (mustFill && !value) {
          isValid = false;
          setFieldError(
            field,
            isMessageField ? copy.missingMessage : copy.required
          );
        } else if (isEmailField && value && !isValidEmail(value)) {
          isValid = false;
          setFieldError(field, copy.invalidEmail);
        }
      });

      return isValid;
    }

    function clearErrors() {
      form.querySelectorAll('.error-message').forEach((el) => el.classList.add('hidden'));
      form.querySelectorAll('input, textarea, select').forEach((field) => {
        field.classList.remove('border-red-500', 'focus:ring-red-500');
      });
      clearTurnstileError();
    }

    function hideMessage() {
      messageDiv.classList.add('hidden');
      messageDiv.innerHTML = '';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      hideMessage();
      clearErrors();

      if (!validateForm()) return;
      if (!validateHumanChecks()) {
        if (honeypotInput?.value.trim()) {
          messageDiv.innerHTML = `
            <p class="text-red-600 font-medium">❌ ${copy.error}</p>
          `;
          messageDiv.classList.remove('hidden');
        }
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalText = submitBtn?.textContent ?? 'Send';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = copy.sending;
      }

      try {
        const supabase = getSupabaseClient();
        if (!supabase) {
          throw new Error('Supabase not configured');
        }

        const formData = new FormData(form);
        const geo = await resolveClientGeo();
        const payload = {
          ...buildPayload(formData, geo),
          source_site: form.dataset.sourceSite?.trim().replace(/^www\./i, '').toLowerCase() || null,
        };

        if (!payload.name || !payload.email) {
          throw new Error('Missing required fields');
        }

        if (!(payload.message ?? '').trim()) {
          const msgField = form.querySelector<HTMLTextAreaElement>(
            'textarea[name="message"], textarea[name="your-message"]'
          );
          if (msgField) setFieldError(msgField, copy.missingMessage);
          throw new Error('Missing message');
        }

        // Always insert a new row so the same email can have multiple timed inquiries
        let { error } = await supabase.from('contact_inquiries').insert(payload);
        if (error && /source_site/i.test(error.message)) {
          const { source_site: _ignored, ...rest } = payload;
          ({ error } = await supabase.from('contact_inquiries').insert(rest));
        }
        if (error && /lead_source/i.test(error.message) && payload.lead_source === 'ai') {
          ({ error } = await supabase.from('contact_inquiries').insert({ ...payload, lead_source: 'other' }));
        }

        if (error) {
          console.error('[inquiry form]', error);
          throw error;
        }

        messageDiv.innerHTML = `
          <p class="text-green-600 font-medium">✅ ${copy.success}</p>
        `;
        messageDiv.classList.remove('hidden');

        const dataLayer = (window as Window & { dataLayer?: Record<string, unknown>[] }).dataLayer;
        dataLayer?.push({
          event: 'form_submission_success',
        });

        // Notify listeners (e.g. WhatsApp lead gate) before leaving the page
        form.dispatchEvent(
          new CustomEvent('inquiry-form:success', {
            bubbles: true,
            detail: {
              name: payload.name,
              email: payload.email,
              message: payload.message ?? '',
              company: payload.company ?? null,
              product: payload.product_interest ?? null,
            },
          })
        );

        try {
          const extra = (payload.extra || {}) as Record<string, unknown>;
          sessionStorage.setItem('ssf:lastInquiry', JSON.stringify({
            name: payload.name,
            email: payload.email,
            product: payload.product_interest ?? '',
            volume: (extra.volume as string) || '',
            at: Date.now(),
          }));
        } catch {
          /* storage blocked: thanks page simply shows no WhatsApp button */
        }
        window.location.assign(thanksPath());
        return;
      } catch (error) {
        console.error('[inquiry form] submit failed', error);
        messageDiv.innerHTML = `
          <p class="text-red-600 font-medium">❌ ${copy.error}</p>
        `;
        messageDiv.classList.remove('hidden');
        resetTurnstile();
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          submitBtn.textContent = originalText;
        }
      }
    });
  }

  function initInquiryForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-inquiry-form]').forEach(bindInquiryForm);
  }

  initInquiryForms();
  document.addEventListener('astro:page-load', initInquiryForms);
  document.addEventListener('astro:after-swap', initInquiryForms);
</script>
