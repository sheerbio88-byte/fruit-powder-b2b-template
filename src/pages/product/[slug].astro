---
import Layout from '~/layouts/PageLayout.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { getInquiryForm } from '~/i18n/forms';
import { getSiteUrl } from '~/utils/site-url';
import { buildProductSchema } from '~/utils/product-schema';
import products from '~/data/catalog/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const form = getInquiryForm('en');
const siteUrl = getSiteUrl();
const related = products
  .filter(
    (item) =>
      item.slug !== product.slug &&
      item.categories.some((category) => product.categories.some((own) => own.slug === category.slug))
  )
  .slice(0, 4);

const metadata = {
  title: product.seoTitle || product.title,
  description: product.description || product.shortText,
  ignoreTitleTemplate: Boolean(product.seoTitle),
  openGraph: product.image ? { images: [{ url: product.image }] } : undefined,
};

// GEO: answer-first summary, fact table and FAQ built only from facts already on this site.
const plain = (html = '') => html.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const firstSentence = (text = '') => {
  const m = text.match(/^.+?[.!?](?=\s|$)/);
  return m ? m[0].trim() : '';
};
const category = product.categories[0];
const lead = firstSentence(plain(product.shortHtml) || product.description || plain(product.bodyHtml));
const packingSentence = (plain(product.bodyHtml).match(/[^.]*\b(aluminum foil|aluminium foil|cardboard drum|25\s?kg)[^.]*\./i) || [])[0]?.trim();
const summary = [
  `${product.title} is ${category ? `a ${category.name.toLowerCase()} ingredient` : 'an ingredient'} that Sheer Superfood supplies in bulk and through OEM programs to food, beverage, and supplement businesses from Xi'an, Shaanxi, China.`,
  lead,
  'Prices and specifications are quoted per request through the inquiry form on this page.',
].filter(Boolean);
const facts = [
  ['Product', product.title],
  category && ['Category', category.name],
  ['Supply', 'Bulk ingredient and OEM'],
  packingSentence && ['Packing', packingSentence],
  ['Supplier location', "Xi'an, Shaanxi, China"],
  ['Minimum order', 'No published minimum order; send your volume for a quote'],
  ['How to order', 'Inquiry form on this page'],
].filter(Boolean) as [string, string][];
const faqs = [
  {
    q: `Who supplies ${product.title}?`,
    a: `Sheer Superfood, a fruit and vegetable powder supplier in Xi'an, Shaanxi, China, supplies ${product.title} to businesses in bulk and for OEM programs.`,
  },
  {
    q: `What is the minimum order for ${product.title}?`,
    a: 'The site does not publish a minimum order. Send the volume you need through the inquiry form for a quote.',
  },
  {
    q: `Is OEM available for ${product.title}?`,
    a: 'Custom ingredient and finished-form programs are quoted from the OEM page (/services/).',
  },
  {
    q: `How do I get a price or specification for ${product.title}?`,
    a: 'Use the inquiry form on this page and share the product, specification, packing, and volume.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    ...(category ? [{ name: category.name, path: category.path }] : []),
    { name: product.title, path: product.path },
  ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${siteUrl}${c.path}` })),
};

const productSchema = buildProductSchema({
  name: product.title,
  description: product.description || product.shortText,
  image: product.image,
  url: `${siteUrl}${product.path}`,
  category: product.categories[0]?.name,
});
---

<Layout metadata={metadata}>
  <article class="pt-28 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-10">
      <div>
        {
          product.image && (
            <img src={product.image} alt={product.imageAlt || product.title} class="w-full rounded-md bg-white object-contain" />
          )
        }
      </div>
      <div>
        <p class="text-sm text-muted mb-3">
          <a href="/" class="text-link">Home</a>
          <span aria-hidden="true"> / </span>
          <a href="/products/" class="text-link">Products</a>
          {
            product.categories[0] && (
              <>
                <span aria-hidden="true"> / </span>
                <a href={product.categories[0].path} class="text-link">{product.categories[0].name}</a>
              </>
            )
          }
        </p>
        <h1 class="font-heading text-4xl font-semibold text-heading mb-4">{product.title}</h1>
        <div class="geo-summary text-muted mb-6" data-geo="summary">
          {summary.map((line) => <p class="mb-2">{line}</p>)}
        </div>
        {product.shortHtml && <div class="prose text-muted mb-6" set:html={product.shortHtml} />}
        <p class="text-sm text-muted mb-6">
          {
            product.categories.map((category) => (
              <a href={category.path} class="text-link me-3">{category.name}</a>
            ))
          }
          {
            product.tags.map((tag) => (
              <a href={tag.path} class="text-link me-3">{tag.name}</a>
            ))
          }
        </p>
        <a href="#inquiry-form" class="btn btn-primary">Request a quote</a>
      </div>
    </div>
    {
      product.bodyHtml && (
        <div class="max-w-3xl mx-auto px-4 sm:px-6 mt-12 prose prose-headings:font-heading prose-headings:text-heading overflow-x-auto" set:html={product.bodyHtml} />
      )
    }
  </article>

  <section class="not-prose pb-12" aria-labelledby="facts-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 id="facts-heading" class="font-heading text-2xl font-semibold text-heading mb-4">{product.title} quick facts</h2>
      <table class="w-full text-sm border border-stone-200 mb-10">
        <tbody>
          {facts.map(([k, v]) => (
            <tr class="border-b border-stone-200">
              <th scope="row" class="text-left font-medium text-heading p-3 w-1/3 align-top">{k}</th>
              <td class="p-3 text-muted">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <h2 class="font-heading text-2xl font-semibold text-heading mb-4">FAQ</h2>
      {faqs.map((f) => (
        <details class="border-b border-stone-200 py-3">
          <summary class="font-medium text-heading cursor-pointer">{f.q}</summary>
          <p class="mt-2 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="not-prose pb-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <h2 class="font-heading text-2xl font-semibold text-heading mb-5">Related products</h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {related.map((item) => (
              <a href={item.path} class="border border-stone-200 bg-elevated overflow-hidden">
                {item.image && <img src={item.image} alt={item.title} class="aspect-square w-full bg-white object-contain p-3" loading="lazy" />}
                <span class="block p-3 text-sm font-medium text-heading">{item.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactUs
    id="inquiry-form"
    title={`Inquire about ${product.title}`}
    subtitle="Send the specification, packing, and volume. We reply by email or WhatsApp."
    button={form.button}
    inputs={form.inputs}
    textarea={form.textarea}
    disclaimer={form.disclaimer}
    description={form.description}
  />
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
