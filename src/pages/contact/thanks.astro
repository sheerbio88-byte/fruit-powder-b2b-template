---
import Layout from '~/layouts/PageLayout.astro';


const metadata = {
  title: 'Inquiry received',
  description: 'Your Sheer Superfood inquiry was received.',
  ignoreTitleTemplate: true,
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="not-prose py-20 md:py-28">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-[11px] font-semibold tracking-[0.22em] uppercase text-primary mb-4">Inquiry received</p>
      <h1 class="font-heading text-3xl md:text-4xl font-medium text-heading mb-4">Thank you — we have your request</h1>
      <p class="text-muted leading-relaxed mb-8">
        Sales will reply by email. If the request is urgent, continue on WhatsApp.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <span data-wa-after hidden></span>
        <a href="/products/" class="btn">Browse catalog</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var slot = document.querySelector('[data-wa-after]');
    if (!slot) return;
    var data = null;
    try { data = JSON.parse(sessionStorage.getItem('ssf:lastInquiry') || 'null'); } catch (e) { data = null; }
    if (!data || !data.at || Date.now() - data.at > 30 * 60 * 1000) return;
    var lines = ['Sheer Superfood inquiry', data.name && 'Name: ' + data.name, data.email && 'Email: ' + data.email, data.product && 'Product: ' + data.product, data.volume && 'Volume: ' + data.volume].filter(Boolean);
    var a = document.createElement('a');
    a.className = 'btn btn-primary';
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.href = 'https://wa.me/' + String(import.meta.env.PUBLIC_CONTACT_WHATSAPP_NUMBER || '').replace(/\D/g, '') + '?text=' + encodeURIComponent(lines.join('\n'));
    a.textContent = 'Chat on WhatsApp';
    slot.replaceWith(a);
  })();
</script>
