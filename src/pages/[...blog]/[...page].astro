---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogListMetadata } from '~/utils/blog-archive-seo';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { buildBlogCollectionSchema } from '~/utils/collection-schema';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// const allCategories = await findCategories();
// const allTags = await findTags();

const blogMeta = getBlogListMetadata(currentPage);

const metadata = {
  title: blogMeta.title,
  description: blogMeta.description,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: blogMeta.openGraph,
};

const isIndexed = blogListRobots?.index && currentPage === 1;
const archiveUrl = String(getCanonical(Astro.url.pathname));
const collectionSchema = isIndexed
  ? buildBlogCollectionSchema({
      name: blogMeta.title,
      description: blogMeta.description,
      url: archiveUrl,
      posts: page.data.map((post) => ({
        title: post.title,
        url: String(getCanonical(getPermalink(post.permalink, 'post'))),
      })),
    })
  : null;
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Notes on fruit and vegetable powders for food, beverage, and supplement use.">
      Blog
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>

  {collectionSchema && <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />}
</Layout>
