---
import Layout from '~/layouts/PageLayout.astro';
import { I18N_LOCALES, pagePath, type Locale } from '~/i18n/locales';
import { productTitle, tagName } from '~/i18n/titles';
import { getUi } from '~/i18n/ui';
import tags from '~/data/catalog/tags.json';
import products from '~/data/catalog/products.json';

export function getStaticPaths() {
  return I18N_LOCALES.flatMap((lang) =>
    tags.map((tag) => ({
      params: { lang, slug: tag.slug },
      props: { tag },
    }))
  );
}

const locale = Astro.params.lang as Locale;
const { tag } = Astro.props;
const ui = getUi(locale);
const name = tagName(tag.slug, tag.name, locale);
const items = products.filter((product) => product.tags.some((item) => item.slug === tag.slug));
const metadata = {
  title: name,
  description: ui.categoryMeta(name),
};
---

<Layout metadata={metadata}>
  <section class="not-prose pt-28 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h1 class="font-heading text-4xl font-semibold text-heading mb-4">{name}</h1>
      <p class="max-w-2xl text-muted mb-8">{ui.categoryMeta(name)} {ui.productCount(items.length)}</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {
          items.map((product) => (
            <a href={pagePath(product.path, locale)} class="border border-stone-200 bg-elevated overflow-hidden">
              {product.image && (
                <img
                  src={product.image}
                  alt={productTitle(product.slug, product.title, locale)}
                  class="aspect-square w-full bg-white object-contain p-3"
                  loading="lazy"
                />
              )}
              <span class="block p-3 text-sm font-medium text-heading">{productTitle(product.slug, product.title, locale)}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
