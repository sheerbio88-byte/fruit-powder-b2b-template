---
import Layout from '~/layouts/PageLayout.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { getInquiryForm } from '~/i18n/forms';
import { I18N_LOCALES, type Locale } from '~/i18n/locales';
import { getUi } from '~/i18n/ui';

export function getStaticPaths() {
  return I18N_LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const ui = getUi(locale);
const form = getInquiryForm(locale);
const metadata = {
  title: ui.oemTitle,
  description: ui.metaOemDescription,
};
---

<Layout metadata={metadata}>
  <section class="not-prose pt-28 pb-8">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-4">
      <h1 class="font-heading text-4xl font-semibold text-heading">{ui.oemTitle}</h1>
      {ui.serviceParagraphs.map((paragraph) => <p class="text-muted leading-relaxed">{paragraph}</p>)}
    </div>
  </section>
  <ContactUs
    id="inquiry-form"
    title={ui.oemInquiry}
    subtitle={ui.oemInquirySub}
    button={form.button}
    inputs={form.inputs}
    textarea={form.textarea}
    disclaimer={form.disclaimer}
    description={form.description}
  />
</Layout>
