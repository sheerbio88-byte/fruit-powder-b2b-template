---
import Layout from '~/layouts/PageLayout.astro';
import categories from '~/data/catalog/categories.json';
import products from '~/data/catalog/products.json';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = products.filter((product) =>
  product.categories.some((item) => item.slug === category.slug || item.slug.startsWith(`${category.slug}/`))
);

const metadata = {
  title: category.seoTitle || category.name,
  description: category.description || `${category.name} supplied for food, beverage, and supplement brands.`,
  ignoreTitleTemplate: Boolean(category.seoTitle),
};
---

<Layout metadata={metadata}>
  <section class="pt-28 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <p class="text-sm text-muted mb-3">
        <a href="/products/" class="text-link">Products</a>
      </p>
      <h1 class="font-heading text-4xl font-semibold text-heading mb-4">{category.name}</h1>
      {category.introHtml && <div class="prose prose-headings:font-heading prose-headings:text-heading max-w-3xl text-muted mb-6" set:html={category.introHtml} />}
      <p class="max-w-2xl text-muted mb-8">{items.length === 1 ? '1 product' : `${items.length} products`}</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {
          items.map((product) => (
            <a href={product.path} class="border border-stone-200 bg-elevated overflow-hidden hover:border-primary/40">
              {product.image && <img src={product.image} alt={product.imageAlt || product.title} class="aspect-square w-full bg-white object-contain p-3" loading="lazy" />}
              <span class="block p-3 text-sm font-medium text-heading">{product.title}</span>
            </a>
          ))
        }
      </div>
      {items.length === 0 && <p class="text-muted">No products are listed in this category yet.</p>}
    </div>
  </section>
</Layout>
