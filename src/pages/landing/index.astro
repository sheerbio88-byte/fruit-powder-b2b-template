---
import LandingShell from '~/components/landing/LandingShell.astro';

const metadata = {
  title: 'Landing pages | Sheer Superfood',
  description: 'Noindex index of Sheer Superfood ad landing pages for ube powder.',
  ignoreTitleTemplate: true,
  robots: { index: false, follow: true },
  canonical: 'https://sheersuperfood.com/landing/',
};

const pages = [
  {
    href: '/landing/fruit-powder-factory-direct-ads/',
    tag: 'Factory layout',
    title: 'Ube powder, bulk or in bags',
    text: 'Industrial page: slate trust strip, icon cards, process row, and a two-column quote. Bulk is filled in first.',
  },
  {
    href: '/landing/fruit-powder-seller-direct-ads/',
    tag: 'Collection layout',
    title: 'Bags for the shelf',
    text: 'Cream editorial page: serif headline, quote card in the hero, and three alternating packs — bags, bulk, private label.',
  },
  {
    href: '/landing/most-profitable-products-direct-ads/',
    tag: 'Pair layout',
    title: 'The powder and the bag',
    text: 'Split headline and two kits, bag then bulk, with private label kept on the bag. One factory quote. No published margin.',
  },
];
---

<LandingShell metadata={metadata} quoteHref="">
  <section class="py-14 md:py-16">
    <div class="mx-auto max-w-3xl px-4 md:px-6">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-primary">Ads</p>
      <h1 class="font-heading text-4xl font-semibold tracking-tight text-heading">Landing pages</h1>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        English ad pages for ube powder (purple yam, 紫山药). Each page is noindex, uses the same inquiry form, and uses a
        different layout.
      </p>
      <ul class="mt-8 space-y-4">
        {
          pages.map((page) => (
            <li>
              <a href={page.href} class="block rounded-xl border border-stone-200/90 bg-elevated p-5 hover:border-primary">
                <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">{page.tag}</p>
                <h2 class="mt-2 font-heading text-xl font-semibold text-heading">{page.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{page.text}</p>
                <p class="mt-3 text-sm font-medium text-primary">{page.href}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</LandingShell>
