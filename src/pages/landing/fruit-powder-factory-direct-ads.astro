          ))
        }
      </div>
    </section>

    <section class="py-12 md:py-14">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="mb-6 text-2xl font-bold md:text-3xl">Questions</h2>
        <dl class="divide-y divide-gray-200 border-y border-gray-200">
          {
            faqs.map((item) => (
              <div class="py-5">
                <dt class="font-semibold text-default">{item.q}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <footer class="border-t border-gray-200">
      <p class="mx-auto max-w-7xl px-4 py-6 text-xs text-muted sm:px-6 lg:px-8">
        © {new Date().getFullYear()} Sheer Superfood · Xi’an, China
      </p>
    </footer>
  </div>

  <UbeLandingScript />
</Layout>

