# Copy to .env and fill in. Never commit .env or a service_role key.

# Public site URL (used by Astro `site` and canonical links)
PUBLIC_SITE_URL=https://example.com

# Supabase (anon / publishable key ONLY — never service_role)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
PUBLIC_SOURCE_SITE=example.com

# Cloudflare Turnstile (site / public key)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA_your_site_key

# Contact PII (optional; leave empty to hide WhatsApp follow-up links)
PUBLIC_CONTACT_EMAIL=sales@example.com
PUBLIC_CONTACT_PHONE=+8600000000000
PUBLIC_CONTACT_PHONE_DISPLAY=+86 000 0000 0000
PUBLIC_CONTACT_WHATSAPP=+86 00000000000
PUBLIC_CONTACT_WHATSAPP_HREF=https://wa.me/8600000000000
PUBLIC_CONTACT_WHATSAPP_NUMBER=8600000000000
